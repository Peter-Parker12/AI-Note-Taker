# --- Database (compose overrides this to point at the db service) ---
# DATABASE_URL is set by docker-compose.yml
DB_PASSWORD=change-me

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > token) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=
# Encrypts users' saved API keys. Defaults to AUTH_SECRET; set it to rotate AUTH_SECRET independently.
SETTINGS_ENCRYPTION_KEY=
# Public URL of the app, e.g. https://notes.example.com

AUTH_URL=http://localhost:3010

# --- Defaults. Each account can override these (and add its own API keys) under Account > Settings ---
# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Speech-to-text (claude does not transcribe audio) ---
STT_PROVIDER=openai        # openai | deepgram
STT_LANGUAGE=auto          # auto | vi | en ...
OPENAI_API_KEY=
DEEPGRAM_API_KEY=


# --- Docker host ports ---
HOST_PORT=5930
DB_HOST_PORT=5433

# --- First admin (created on first start only, when no users exist) ---
# Sign in with these, then create other users under Admin and change this password under Account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Lost the admin password? Set ADMIN_PASSWORD, set this to true, restart, then remove it.
RESET_ADMIN_PASSWORD=false
