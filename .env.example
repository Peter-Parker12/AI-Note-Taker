# --- Database (compose overrides this to point at the db service) ---
# DATABASE_URL is set by docker-compose.yml
DB_PASSWORD=change-me

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > token) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public URL of the app, e.g. https://notes.example.com
AUTH_URL=http://localhost:3010
# Comma-separated. Sign-in is refused unless the email matches one of these.
ALLOWED_EMAIL_DOMAINS=yourcompany.com
ALLOWED_EMAILS=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Speech-to-text (claude does not transcribe audio) ---
STT_PROVIDER=openai        # openai | deepgram
STT_LANGUAGE=auto          # auto | vi | en ...
OPENAI_API_KEY=
DEEPGRAM_API_KEY=


# --- Docker host ports ---
HOST_PORT=5930
DB_HOST_PORT=5433

# Always allowed to sign in and made admin (comma-separated). The very first account is also made admin.
ADMIN_EMAILS=
