generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MeetingStatus {
  RECORDING
  UPLOADED
  TRANSCRIBING
  SUMMARIZING
  READY
  FAILED
}

enum Role {
  ADMIN
  MEMBER
}

enum JobType {
  TRANSCRIBE
  SUMMARIZE
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  // Bumped on password change/reset so existing browser sessions stop working.
  sessionVersion Int      @default(0)
  name         String?
  role         Role       @default(MEMBER)
  disabled     Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  tokens       ApiToken[]
  meetings     Meeting[]
  settings     UserSettings?
}

// Personal access tokens for the Chrome extension. Only the sha256 hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Meeting {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  platform       String        @default("other")
  status         MeetingStatus @default(RECORDING)
  error          String?
  audioPath      String?
  chunkCount     Int           @default(0)
  // Whether the recording is stereo (L = my mic, R = everyone else).
  stereo         Boolean       @default(true)
  durationSec    Int?
  startedAt      DateTime      @default(now())
  // [{ speaker, start, end, text }]
  transcript     Json?
  transcriptText String?
  // { summary, decisions[], actionItems[{task, owner, due}], topics[] }
  summary        Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  jobs           Job[]

  @@index([userId, startedAt])
}

// DB-backed queue; a worker loop in instrumentation.ts claims PENDING jobs.
model Job {
  id        String    @id @default(cuid())
  type      JobType
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}


// Per-account configuration. Null/absent fields fall back to the server's env defaults.
// API keys are AES-256-GCM encrypted (lib/crypto.ts).
model UserSettings {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiInstructions  String?
  recapLanguage   String   @default("auto") // auto | vi | en
  sttProvider     String?                   // openai | deepgram
  sttLanguage     String?                   // auto | vi | en ...
  claudeModel     String?
  anthropicKeyEnc String?
  openaiKeyEnc    String?
  deepgramKeyEnc  String?
  updatedAt       DateTime @updatedAt
}
